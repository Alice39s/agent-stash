{
  "name": "@agent-stash/dsh-recall",
  "version": "0.1.1",
  "description": "Browse the prompts of the current DeepSeek Harness session with the arrow keys in the composer",
  "keywords": [
    "dsh-plugin",
    "prompt-history"
  ],
  "homepage": "https://github.com/Alice39s/agent-stash/tree/main/dsh/recall#readme",
  "bugs": "https://github.com/Alice39s/agent-stash/issues",
  "license": "Apache-2.0",
  "author": "Alice39s",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice39s/agent-stash.git",
    "directory": "dsh/recall"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.1-alpha.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@agent-stash/dsh-stash-kit"
      ]
    }
  }
}
