{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "vendor/**",
    "dist/**",
    "packages/*/dist/**",
    "packages/*/CHANGELOG.md",
    "dsh/*/dist/**",
    "dsh/*/CHANGELOG.md",
    "dsh/enhance/vendor/**",
    "skills/code-styleguide/**",
    "prompts/**",
    ".tegami/**",
    "CHANGELOG.md",
    "pnpm-lock.yaml",
    "docs/.next/**",
    "docs/.source/**",
    "docs/out/**",
    "docs/next-env.d.ts"
  ]
}
