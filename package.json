{
  "name": "@agent-stash/init",
  "version": "1.4.1",
  "description": "Personal Agent Skills and /init plugins for pi, DeepSeek Harness, Cline, Grok Build, goose, and Aider",
  "keywords": [
    "cline-plugin",
    "dsh-plugin",
    "pi-package"
  ],
  "homepage": "https://github.com/Alice39s/agent-stash#readme",
  "bugs": "https://github.com/Alice39s/agent-stash/issues",
  "license": "Apache-2.0",
  "author": "Alice39s",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice39s/agent-stash.git"
  },
  "bin": {
    "agent-stash": "./dist/cli/agent-stash.js"
  },
  "files": [
    "pi",
    "prompts",
    "src",
    "dsh/cordis.patch.yml",
    "dsh/init",
    "dsh/locale",
    "dist",
    "skills",
    "vendor",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/dsh/init.js",
    "./client": "./dist/dsh/client.js",
    "./locale/*.json": "./dsh/locale/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bundle": "tsdown",
    "sync:code-styleguide": "node scripts/sync-code-styleguide.ts",
    "sync:init-prompts": "node scripts/sync-init-prompts.ts",
    "tegami": "node scripts/tegami.ts",
    "test": "vitest run",
    "lint": "oxlint --type-aware --type-check --deny-warnings",
    "format": "oxfmt",
    "check": "oxfmt --check && oxlint --type-aware --type-check --deny-warnings && vitest run"
  },
  "dependencies": {
    "pathe": "^2.0.3",
    "valibot": "^1.5.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@octokit/rest": "^22.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/murmurhash3js-revisited": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@types/semver": "^7.8.0",
    "happy-dom": "^21.0.4",
    "hast-util-select": "^6.0.4",
    "hast-util-to-mdast": "^10.1.2",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "murmurhash3js-revisited": "^3.0.0",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "semver": "^7.8.5",
    "tegami": "^1.5.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "icon": "./dsh/init/icon.svg",
  "engines": {
    "dsh": ">=0.2.1-alpha.2",
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./dist/cline/init.js"
        ],
        "capabilities": [
          "commands"
        ]
      }
    ]
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "pi": {
    "extensions": [
      "./pi/extensions/init/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
