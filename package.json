{
  "name": "agent-stash",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Agent Skills, Pi extensions, and DeepSeek Harness plugins",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "files": [
    "pi",
    "vendor",
    "LICENSE"
  ],
